# Supabase (required for Phase 1 backend)
# Copy to .env and fill in from Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: override Supabase email auth redirect (signup confirm + password reset).
# Defaults to expo-linking URL (http://localhost:8081/login on Expo Web dev, natures-grace://login on native builds).
# EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Express API (payout dispatch from mobile; default local dev)
EXPO_PUBLIC_API_URL=http://localhost:5000

# Server-only: Supabase service role (webhooks + payout lifecycle; never ship to the app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RazorpayX (server-only payout disbursement)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_FUND_ACCOUNT_ID=
# Optional: IMPS | NEFT | RTGS | UPI
RAZORPAYX_PAYOUT_MODE=IMPS

# Dev only: auto-complete payouts when RazorpayX keys are missing (never enable in production)
PAYOUT_DEV_AUTO_COMPLETE=false

# Razorpay Checkout (store + booking payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Publishable key for mobile checkout UI (same as RAZORPAY_KEY_ID)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Optional: server-side Postgres (existing Drizzle setup — not used by mobile auth yet)
DATABASE_URL=

# Optional: Firebase (wellness journal/gratitude sync — app works without these)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: production web domain for API CORS (comma-separated origins also supported)
# EXPO_PUBLIC_DOMAIN=your-app.example.com
# CORS_ALLOWED_ORIGINS=https://your-app.example.com,https://staging.example.com

# Supabase migrations: before applying 036_orders_notifications_hardening.sql, verify
# no duplicate order_number values exist:
# SELECT order_number, COUNT(*) FROM orders GROUP BY order_number HAVING COUNT(*) > 1;
