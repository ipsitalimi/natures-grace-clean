# =============================================================================
# Nature's Grace — environment template
# Copy to .env and fill in values. Restart Expo + API server after changes.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required — app + auth)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only (same project URL + service_role key — never ship to the app)
# Use full URL: https://your-project.supabase.co (not just the project ref)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: auth email redirect override (web / local dev only)
# Native Play Store builds use natures-grace://auth/callback automatically.
# Add the same URL in Supabase → Authentication → URL Configuration → Redirect URLs:
#   natures-grace://auth/callback
# EXPO_PUBLIC_AUTH_REDIRECT_URL=natures-grace://auth/callback

# -----------------------------------------------------------------------------
# Express API (required for store checkout, wallet, payouts)
# Local dev: http://localhost:5000  |  Production: https://your-api.example.com
# Value must be the URL only — do not repeat the variable name (EXPO_PUBLIC_API_URL=https://…)
# Never ship localhost in Play Store / EAS production builds.
# EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_API_URL=http://localhost:5000
PORT=5000

# -----------------------------------------------------------------------------
# Razorpay Checkout — store + session payments
# Dashboard → Account & Settings → API Keys
# Key ID = publishable (rzp_test_… or rzp_live_…)
# Key Secret = server-only — never put in EXPO_PUBLIC_*
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same Key ID as above (used by the mobile checkout UI)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Webhook secret for POST /api/webhooks/razorpay (event: payment.captured)
# Dashboard → Webhooks → create webhook → copy secret
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email — Resend (backend transactional mail)
# Required for backend emails: EMAIL_PROVIDER=resend + RESEND_API_KEY
# Recommended: EMAIL_FROM using a domain verified in Resend (defaults below if unset)
# Signup verification & password-reset links stay on Supabase Auth — not Resend.
# https://resend.com/docs/dashboard/domains/introduction
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Nature's Grace <noreply@naturesgrace.app>

# -----------------------------------------------------------------------------
# Push notifications (optional — server sends via Expo push API)
# -----------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Web / CORS (optional — production deployments)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_DOMAIN=your-app.example.com
# CORS_ALLOWED_ORIGINS=https://your-app.example.com

# -----------------------------------------------------------------------------
# Firebase (optional — journal/gratitude sync)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Postgres / Drizzle (optional — not used by mobile auth)
# -----------------------------------------------------------------------------
# DATABASE_URL=
