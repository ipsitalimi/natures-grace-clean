# Nature's Grace — STAGING ONLY
# Populate with a dedicated non-production Supabase project, Razorpay TEST credentials,
# and staging API host. Never copy production values into this file.
# Keep real values in an untracked .env.staging file or your EAS "preview" environment.

# Client (Expo public values; these are visible in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<staging-supabase-publishable-anon-key>
EXPO_PUBLIC_API_URL=https://<staging-api-host>
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_<staging-key-id>
EXPO_PUBLIC_AUTH_REDIRECT_URL=natures-grace://auth/callback

# API server only — never prefix these with EXPO_PUBLIC_ and never bundle them
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<staging-supabase-service-role-key>
PORT=5000
NODE_ENV=production

# Razorpay TEST account only; webhook endpoint must point to the staging API
RAZORPAY_KEY_ID=rzp_test_<staging-key-id>
RAZORPAY_KEY_SECRET=<staging-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<staging-razorpay-webhook-secret>

# Transactional email — use a staging-safe sender/domain and test inboxes
EMAIL_PROVIDER=resend
RESEND_API_KEY=<staging-resend-api-key>
EMAIL_FROM=Nature's Grace Staging <staging-noreply@example.invalid>

# Optional push delivery; leave unset to test in-app notifications only
EXPO_ACCESS_TOKEN=

# Optional CORS allowlist for the staging app origin
CORS_ALLOWED_ORIGINS=https://<staging-app-host>

# Optional Firebase journal/gratitude sync (only if a separate staging Firebase project exists)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
